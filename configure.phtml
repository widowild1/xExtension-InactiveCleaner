<?php
$counts = InactiveCleanerExtension::getThresholdCounts();
$thresholds = InactiveCleanerExtension::THRESHOLDS;
?>
<div class="post">
    <h2><?= InactiveCleanerExtension::t('title') ?></h2>
    <p><?= InactiveCleanerExtension::t('desc') ?></p>
    
    <div class="alert alert-warn">
        <strong><?= InactiveCleanerExtension::t('warning_title') ?></strong> <?= InactiveCleanerExtension::t('warning_desc') ?>
    </div>
    
    <form action="<?= _url('extension', 'configure', 'e', Minz_Request::param('e', 'Inactive Feeds Cleaner')) ?>" method="post">
        <input type="hidden" name="_csrf" value="<?= method_exists('FreshRSS_Auth', 'csrfToken') ? FreshRSS_Auth::csrfToken() : Minz_Session::param('_csrf') ?>" />

        <div class="form-group">
            <label class="group-name" for="inactivity_period"><?= InactiveCleanerExtension::t('period_label') ?></label>
            <div class="group-controls">
                <select name="inactivity_period" id="inactivity_period" style="min-width: 420px; max-width: 100%;">
                    <?php foreach ($thresholds as $days): ?>
                        <?php 
                            $c = $counts[$days] ?? 0;
                            $countText = ($c > 0) ? InactiveCleanerExtension::t('feeds_count', $c) : InactiveCleanerExtension::t('no_feeds');
                            $selected = ($days === 90) ? 'selected="selected"' : '';
                        ?>
                        <option value="<?= $days ?>" <?= $selected ?>>
                            <?= InactiveCleanerExtension::t('period_' . $days) ?> — <?= $countText ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>

        <div class="form-group form-actions">
            <div class="group-controls">
                <button type="submit" name="clean_action" value="export_opml" class="btn">
                    <?= InactiveCleanerExtension::t('btn_export') ?>
                </button>
                <button type="submit" name="clean_action" value="clean_feeds" class="btn btn-important" onclick="return confirm('<?= addslashes(InactiveCleanerExtension::t('confirm_delete')) ?>');">
                    <?= InactiveCleanerExtension::t('btn_clean') ?>
                </button>
            </div>
        </div>
    </form>
    
    <p class="help" style="margin-top: 25px; color: #777;">
        ℹ️ <em><?= InactiveCleanerExtension::t('log_info') ?></em>
    </p>
</div>
